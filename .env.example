# Copy to .env and fill in. studio.py loads this into the environment so the
# stage subprocesses (plan.py, generate_images.py) inherit the keys.

# Stage 1 - plan.py script generation. Pick a provider per project in the UI.
# The default "Claude Code (subscription)" provider uses the local `claude` CLI
# login and needs NO key here. Set a key only for the API providers:
#   Claude API  - console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
#   Gemini API  - aistudio.google.com/apikey
GEMINI_API_KEY=

# Stage 2 - generate_images.py (Cloudflare Workers AI, FLUX.1 Schnell).
# dash.cloudflare.com -> AI -> Workers AI. Free ~230 images/day, no card.
CF_ACCOUNT_ID=
CF_API_TOKEN=
